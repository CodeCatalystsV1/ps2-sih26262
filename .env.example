# Database connection (SQLite local storage)
DATABASE_URL="file:./dev.db"

# ==============================================================
# NOTIFICATION & OUTBOUND GATEWAY CONFIGURATION (OPTIONAL)
# If left unset, the system uses the Ethereal / Simulated Sandbox.
# ==============================================================

# Option A: Resend API (Recommended for live email delivery)
# Sign up at https://resend.com (free 100 emails/day, no credit card required)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="AICTE Flow <onboarding@resend.dev>"

# Option B: Standard SMTP (Gmail, Outlook, College Server)
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-character-app-password"
# SMTP_SECURE="false"

# Option C: Fast2SMS (India SMS Gateway)
# Sign up at https://www.fast2sms.com
# FAST2SMS_API_KEY="your_fast2sms_api_key"

# Option D: Twilio SMS (Global SMS)
# TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_AUTH_TOKEN="your_auth_token"
# TWILIO_PHONE_NUMBER="+1234567890"
